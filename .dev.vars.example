# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Resend API key (required for sending email). Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Resend webhook signing secret (required for delivery-status webhooks).
# Create a webhook for email.delivered/bounced/complained/failed/etc. at
# https://resend.com/webhooks and copy its signing secret (whsec_...).
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
